usage() {
	OPTIONS_SPEC="\
git flow init

Initialize a new git repo with support for the branching model.

For more specific help type the command followed by --help
--
"
	flags_help
}

# Parse arguments and set common variables
parse_args() {
	FLAGS "$@" || exit $?
	eval set -- "${FLAGS_ARGV}"
}

# Default entry when no SUBACTION is given
cmd_default() {
	OPTIONS_SPEC="\
git flow init [-h] [-d] [-f]

Setup a git repository for git flow usage. Can also be used to start a git repository.
--
h,help!             Show this help
showcommands!       Show git commands while executing them
d,[no]defaults      Use default branch naming conventions
f,[no]force         Force setting of gitflow branches, even if already configured
w,[no]worktree      Use git worktree for branch lifecycle management (sticky; use -f to change it later)

p,feature!          Feature branches
b,bugfix!           Bugfix branches
r,release!          Release branches
x,hotfix!           Hotfix branches
s,support!          Support branches
t,tag!              Version tag prefix

Use config file location
local!   use repository config file
global!  use global config file
system!  use system config file
file=    use given config file
"
	local gitflow_config_option should_check_existence branchcount guess
	local master_branch develop_branch default_suggestion answer prefix

	# Define flags
	DEFINE_boolean 'force' false 'force setting of gitflow branches, even if already configured' f
	DEFINE_boolean 'defaults' false 'use default branch naming conventions' d
	# Default to whatever is already configured, so a plain `-f` reinit
	# that doesn't mention --worktree/--no-worktree leaves it untouched.
	if gitflow_worktree_enabled; then
		DEFINE_boolean 'worktree' true 'use git worktree for branch lifecycle management' w
	else
		DEFINE_boolean 'worktree' false 'use git worktree for branch lifecycle management' w
	fi
	DEFINE_boolean 'local' false 'use repository config file'
	DEFINE_boolean 'global' false 'use global config file'
	DEFINE_boolean 'system' false 'use system config file'
	DEFINE_string 'file' "" 'use given config file'
	DEFINE_string 'feature' "" 'feature branches' p
	DEFINE_string 'bugfix' "" 'bugfix branches' b
	DEFINE_string 'release' "" 'release branches' r
	DEFINE_string 'hotfix' "" 'hotfix branches' x
	DEFINE_string 'support' "" 'support branches' s
	DEFINE_string 'tag' "" 'version tag prefix' t

	# Override defaults with values from config
	gitflow_override_flag_boolean   "init.defaults"   "defaults"

	# Parse arguments
	parse_args "$@"

	if [ "$FLAGS_file" != "" ]; then
		gitflow_config_option="--file $FLAGS_file"
	elif flag local; then
		gitflow_config_option="--local"
	elif flag global; then
		gitflow_config_option="--global"
	elif flag system; then
		gitflow_config_option="--system"
	else
		gitflow_config_option=""
	fi

	if git_config_bool_exists "user.useconfigonly"; then
		user_email=$(git config --get user.email)
		user_name=$(git config --get user.name)
		if [ -z "${user_email}" ] || [ -z "${user_name}" ]; then
			die "Configuration useconfigonly is set but no name and/or email was set"
		fi
	fi

	if ! git rev-parse --git-dir >/dev/null 2>&1; then
		git_do init
	else
		# Assure that we are not working in a repo with local changes
		git_repo_is_headless || require_clean_working_tree
	fi

	# Running git flow init on an already initialized repo is fine
	if gitflow_is_initialized && ! flag force; then
		warn "Already initialized for gitflow."
		warn "To force reinitialization, use: git flow init -f"
		exit 0
	fi

	if flag defaults; then
		warn "Using default branch names."
	fi

	# Add a master branch if no such branch exists yet

	if gitflow_has_master_configured && ! flag force; then
		master_branch=$(git config --get gitflow.branch.master)
	else
		# Two cases are distinguished:
		# 1. A fresh git repo (without any branches)
		#    We will create a new master/develop branch for the user
		# 2. Some branches do already exist
		#    We will disallow creation of new master/develop branches and
		#    rather allow to use existing branches for git-flow.
		branch_count=$(git_local_branches | wc -l)
		if [ "$branch_count" -eq 0 ]; then
			echo "No branches exist yet. Base branches must be created now."
			should_check_existence=NO
			default_suggestion=$(git config --get gitflow.branch.master || echo master)
		else
			echo
			echo "Which branch should be used for bringing forth production releases?"
			git_local_branches | sed 's/^.*$/   - &/g'

			should_check_existence=YES
			default_suggestion=
			for guess in $(git config --get gitflow.branch.master) 'production' 'main' 'master'; do
				if git_local_branch_exists "$guess"; then
					default_suggestion="$guess"
					break
				fi
			done

		fi

		if [ -z $default_suggestion ] && flag defaults; then
				should_check_existence=YES
				default_suggestion=$(git config --get gitflow.branch.master || echo master)
		fi

		printf "Branch name for production releases: [$default_suggestion] "
		if noflag defaults; then
			read answer
		else
			printf "\n"
		fi
		master_branch=${answer:-$default_suggestion}

		# Check existence in case of an already existing repo
		if [ "$should_check_existence" = "YES" ]; then
			# If no local branch exists and a remote branch of the same
			# name exists, checkout that branch and use it for master
			if ! git_local_branch_exists "$master_branch" && git_remote_branch_exists "origin/$master_branch"; then
				git_do branch "$master_branch" "origin/$master_branch" >/dev/null 2>&1
			elif ! git_local_branch_exists "$master_branch"; then
				die "Local branch '$master_branch' does not exist."
			fi
		fi

		# Store the name of the master branch
		git_do config $gitflow_config_option gitflow.branch.master "$master_branch"
	fi

	# Add a develop branch if no such branch exists yet
	if gitflow_has_develop_configured && ! flag force; then
		develop_branch=$(git config --get gitflow.branch.develop)
	else
		# Again, the same two cases as with the master selection are
		# considered (fresh repo or repo that contains branches)
		branch_count=$(git_local_branches | grep -v "^${master_branch}\$" | wc -l)
		if [ "$branch_count" -eq 0 ]; then
			should_check_existence=NO
			default_suggestion=$(git config --get gitflow.branch.develop || echo develop)
		else
			echo
			echo "Which branch should be used for integration of the \"next release\"?"
			git_local_branches | grep -v "^${master_branch}\$" | sed 's/^.*$/   - &/g'

			should_check_existence=YES
			default_suggestion=
			for guess in $(git config --get gitflow.branch.develop) 'develop' 'int' 'integration' 'master'; do
				if git_local_branch_exists "$guess" && [ "$guess" != "$master_branch" ]; then
					default_suggestion="$guess"
					break
				fi
			done
		fi

		if [ -z $default_suggestion ] && flag defaults; then
			should_check_existence=YES
			default_suggestion=$(git config --get gitflow.branch.develop || echo develop)
		fi

		printf "Branch name for \"next release\" development: [$default_suggestion] "
		if noflag defaults; then
			read answer
		else
			printf "\n"
		fi
		develop_branch=${answer:-$default_suggestion}

		if [ "$master_branch" = "$develop_branch" ]; then
			die "Production and integration branches should differ."
		fi

		# Check existence in case of an already existing repo
		if [ "$should_check_existence" = "YES" ]; then
			git_local_branch_exists "$develop_branch" || die "Local branch '$develop_branch' does not exist."
		fi

		# Store the name of the develop branch
		git_do config $gitflow_config_option gitflow.branch.develop "$develop_branch"
	fi

	# Creation of HEAD
	# ----------------
	# We create a HEAD now, if it does not exist yet (in a fresh repo). We need
	# it to be able to create new branches.
	local created_gitflow_branch=0
	if ! git rev-parse --quiet --verify HEAD >/dev/null 2>&1; then
		git_do symbolic-ref HEAD "refs/heads/$master_branch"
		git_do commit --allow-empty --quiet -m "Initial commit"
		created_gitflow_branch=1
	fi

	# Creation of master
	# ------------------
	# At this point, there always is a master branch: either it existed already
	# (and was picked interactively as the production branch) or it has just
	# been created in a fresh repo

	# Creation of develop
	# -------------------
	# The develop branch possibly does not exist yet.  This is the case when,
	# in a git init'ed repo with one or more commits, master was picked as the
	# default production branch and develop was "created".  We should create
	# the develop branch now in that case (we base it on master, of course)
	if ! git_local_branch_exists "$develop_branch"; then
		if git_remote_branch_exists "origin/$develop_branch"; then
			git_do branch "$develop_branch" "origin/$develop_branch" >/dev/null 2>&1
		else
			git_do branch --no-track "$develop_branch" "$master_branch"
		fi
		created_gitflow_branch=1
	fi

	# Assert the git-flow repo has been correctly initialized
	gitflow_is_initialized

	# Switch to develop branch if its newly created
	if [ $created_gitflow_branch -eq 1 ]; then
		git_do checkout -q "$develop_branch" || die "Could not check out branch '$develop_branch'."
	fi

	# Ask the user for naming conventions (branch and tag prefixes )
	if flag force || \
		! git config --get gitflow.prefix.feature >/dev/null 2>&1 ||
		! git config --get gitflow.prefix.bugfix >/dev/null 2>&1 ||
		! git config --get gitflow.prefix.release >/dev/null 2>&1 ||
		! git config --get gitflow.prefix.hotfix >/dev/null 2>&1 ||
		! git config --get gitflow.prefix.support >/dev/null 2>&1 ||
		! git config --get gitflow.prefix.versiontag >/dev/null 2>&1; then
		echo
		echo "How to name your supporting branch prefixes?"
	fi

	# Feature branches
	if ! git config --get gitflow.prefix.feature >/dev/null 2>&1 || flag force; then
	    if [ "$FLAGS_feature" != "" ]; then
	        default_suggestion=$(echo $FLAGS_feature)
        else
	    	default_suggestion=$(git config --get --system gitflow.prefix.feature || git config --get --global gitflow.prefix.feature || echo feature/)
        fi
		printf "Feature branches? [$default_suggestion] "
		if noflag defaults; then
			read answer
		else
			printf "\n"
		fi
		[ "$answer" = "-" ] && prefix= || prefix=${answer:-$default_suggestion}
		git_do config $gitflow_config_option gitflow.prefix.feature "$prefix"
	fi

	# Bugfix branches
	if ! git config --get gitflow.prefix.bugfix >/dev/null 2>&1 || flag force; then
	    if [ "$FLAGS_bugfix" != "" ]; then
	        default_suggestion=$(echo $FLAGS_bugfix)
        else
		    default_suggestion=$(git config --get --system gitflow.prefix.bugfix || git config --get --global gitflow.prefix.bugfix || echo bugfix/)
        fi
		printf "Bugfix branches? [$default_suggestion] "
		if noflag defaults; then
			read answer
		else
			printf "\n"
		fi
		[ "$answer" = "-" ] && prefix= || prefix=${answer:-$default_suggestion}
		git_do config $gitflow_config_option gitflow.prefix.bugfix "$prefix"
	fi

	# Release branches
	if ! git config --get gitflow.prefix.release >/dev/null 2>&1 || flag force; then
	    if [ "$FLAGS_release" != "" ]; then
	        default_suggestion=$(echo $FLAGS_release)
        else
		    default_suggestion=$(git config --get --system gitflow.prefix.release || git config --get --global gitflow.prefix.release || echo release/)
        fi
		printf "Release branches? [$default_suggestion] "
		if noflag defaults; then
			read answer
		else
			printf "\n"
		fi
		[ "$answer" = "-" ] && prefix= || prefix=${answer:-$default_suggestion}
		git_do config $gitflow_config_option gitflow.prefix.release "$prefix"
	fi

	# Hotfix branches
	if ! git config --get gitflow.prefix.hotfix >/dev/null 2>&1 || flag force; then
	    if [ "$FLAGS_hotfix" != "" ]; then
	        default_suggestion=$(echo $FLAGS_hotfix)
        else
		    default_suggestion=$(git config --get --system gitflow.prefix.hotfix || git config --get --global gitflow.prefix.hotfix || echo hotfix/)
        fi
		printf "Hotfix branches? [$default_suggestion] "
		if noflag defaults; then
			read answer
		else
			printf "\n"
		fi
		[ "$answer" = "-" ] && prefix= || prefix=${answer:-$default_suggestion}
		git_do config $gitflow_config_option gitflow.prefix.hotfix "$prefix"
	fi

	# Support branches
	if ! git config --get gitflow.prefix.support >/dev/null 2>&1 || flag force; then
	    if [ "$FLAGS_support" != "" ]; then
	        default_suggestion=$(echo $FLAGS_support)
        else
		    default_suggestion=$(git config --get --system gitflow.prefix.support || git config --get --global gitflow.prefix.support || echo support/)
        fi
		printf "Support branches? [$default_suggestion] "
		if noflag defaults; then
			read answer
		else
			printf "\n"
		fi
		[ "$answer" = "-" ] && prefix= || prefix=${answer:-$default_suggestion}
		git_do config $gitflow_config_option gitflow.prefix.support "$prefix"
	fi
	
	# Version tag prefix
	if ! git config --get gitflow.prefix.versiontag >/dev/null 2>&1 || flag force; then
	    if [ "$FLAGS_tag" != "" ]; then
		    default_suggestion=$(echo $FLAGS_tag)
        else
            default_suggestion=$(git config --get --system gitflow.prefix.versiontag || git config --get --global gitflow.prefix.versiontag || echo "")
        fi
		printf "Version tag prefix? [$default_suggestion] "
		if noflag defaults; then
			read answer
		else
			printf "\n"
		fi
		[ "$answer" = "-" ] && prefix= || prefix=${answer:-$default_suggestion}
		git_do config $gitflow_config_option gitflow.prefix.versiontag "$prefix"
	fi

	# Paths
	if ! git config --get gitflow.path.hooks >/dev/null 2>&1 || flag force; then
		# Use the shared common git dir, not --git-dir: see gitflow-common's
		# gitflow_load_settings for why this matters once worktrees exist.
		DOT_GIT_DIR=$(git rev-parse --git-common-dir)
		DOT_GIT_DIR=$(cd "$DOT_GIT_DIR" >/dev/null 2>&1 && pwd)
		default_suggestion=$(git config --get gitflow.path.hooks || git config --get core.hooksPath || echo "$DOT_GIT_DIR"/hooks)
		printf "Hooks and filters directory? [$default_suggestion] "
		if noflag defaults; then
			read answer
		else
			printf "\n"
		fi
		[ "$answer" = "-" ] && hooks_dir= || hooks_dir=${answer:-$default_suggestion}
		git_do config $gitflow_config_option gitflow.path.hooks "$hooks_dir"
	fi

	# Worktree mode
	# -------------
	# Opt-in and sticky: write the setting first (while ".git" still
	# exists at its normal location), then migrate the on-disk layout.
	# Changing it later requires `git flow init -f`.
	if flag worktree; then
		git_do config $gitflow_config_option --bool gitflow.worktree true
		gitflow_init_setup_worktrees "$master_branch" "$develop_branch"
	else
		if gitflow_worktree_enabled; then
			warn "Worktree mode is being disabled. The existing '.bare' directory and worktrees on disk are left as-is; collapsing them back into a single working tree is a manual step."
		fi
		git_do config $gitflow_config_option --bool gitflow.worktree false
	fi

	# TODO: what to do with origin?
}

# gitflow_init_preserved_reason <hub-dir> <name>
#
# Prints the reason (and returns 0) when a top-level entry must stay in
# the repository hub instead of being migrated into a worktree:
# untracked directories excluded by .gitignore, and directories holding
# their own Git repository (moving those would break their relative
# gitdir links). Returns 1 for everything else.
#
gitflow_init_preserved_reason() {
	local hub name full_path

	hub=$1
	name=$2
	full_path=$hub/$name

	# Only untracked directories: an ignore rule must never claim a
	# directory that still has versioned content underneath it.
	if [ -d "$full_path" ] && [ -z "$(git -C "$hub" ls-files -- "$name" | head -n 1)" ]; then
		if git -C "$hub" check-ignore -q -- "$name/" 2>/dev/null ||
			git -C "$hub" check-ignore -q -- "$name" 2>/dev/null; then
			echo "ignored"
			return 0
		fi
	fi
	if [ -e "$full_path/.git" ] || [ -L "$full_path/.git" ]; then
		echo "nested Git repository"
		return 0
	fi
	return 1
}

# gitflow_init_restore_staging <hub-dir> <staging-dir>
#
# Moves everything still in the staging directory back to the hub root
# and removes it. Returns non-zero if any move failed.
#
gitflow_init_restore_staging() {
	local entry restore_failed

	restore_failed=0
	for entry in "$2"/* "$2"/.[!.]* "$2"/..?*; do
		[ -e "$entry" ] || [ -L "$entry" ] || continue
		mv "$entry" "$1/" || restore_failed=1
	done
	[ "$restore_failed" -eq 0 ] || return 1
	rmdir "$2" 2>/dev/null
	return 0
}

# gitflow_init_setup_worktrees()
#
# One-time migration into the opt-in worktree layout: the repository's
# git directory moves to ".bare", whichever branch is currently checked
# out keeps its working files in place (relocated into its own worktree
# directory, including anything uncommitted or untracked), master and
# develop each get their own permanent worktree, and persistent
# container directories are created for every configured branch-type
# prefix. Safe to call repeatedly: it skips the migration itself when
# ".bare" already exists, but still (re-)creates any missing prefix
# container directories.
#
# Top-level directories excluded by .gitignore, and top-level
# directories holding their own Git repository, are never moved: they
# stay in the hub root and are reported at the end of the migration.
#
# $1 Master branch name
# $2 Develop branch name
#
gitflow_init_setup_worktrees() {
	local master_branch develop_branch repo_root bare_dir cur_branch entry prefix prefix_dir staging
	local name reason preserved

	master_branch=$1
	develop_branch=$2

	# Not --show-toplevel: once ".bare" exists, the hub root has no work
	# tree of its own (git reports it as bare from there), so the hub dir
	# must be derived from the common git dir instead, which resolves
	# correctly both before migration (parent of ".git") and after
	# (parent of ".bare").
	repo_root="$(gitflow_worktree_hub_dir)"
	bare_dir="$repo_root/.bare"
	preserved=

	if [ -d "$bare_dir" ]; then
		warn "Worktree layout already set up ('.bare' exists); skipping migration."
	else
		cur_branch=$(git_current_branch)
		if [ "$cur_branch" = "(unnamed branch)" ]; then
			die "Cannot enable worktree mode from a detached HEAD. Check out '$master_branch' or '$develop_branch' first, then run 'git flow init -f --worktree' again."
		fi

		# Pass 1: decide what stays at the hub without modifying anything
		# yet, so a collision with a worktree directory aborts cleanly.
		for entry in "$repo_root"/* "$repo_root"/.[!.]* "$repo_root"/..?*; do
			[ -e "$entry" ] || [ -L "$entry" ] || continue
			name=$(basename "$entry")
			case "$name" in
			.git | .gitflow-migrate-tmp) continue ;;
			esac
			reason=$(gitflow_init_preserved_reason "$repo_root" "$name") || continue
			if [ "$name" = "$cur_branch" ] || [ "$name" = "$master_branch" ] || [ "$name" = "$develop_branch" ]; then
				die "Cannot migrate: '$name' must stay at the hub, but it is also the worktree directory for the current, master or develop branch. Rename or move '$name' and re-run 'git flow init -f --worktree'."
			fi
			preserved="${preserved}  ${name} (${reason})
"
		done

		# "git worktree add" requires its target path to not already
		# exist, so stage the rest of the repo root (tracked and
		# untracked alike) out of the way first, relocate ".git", let
		# "worktree add" create a fresh empty directory for the branch,
		# then move the staged files back into it. Entries preserved by
		# pass 1 are never moved.
		staging="$repo_root/.gitflow-migrate-tmp"
		mkdir "$staging" || die "Could not create staging directory '$staging'. If it is left over from an earlier failed migration, inspect it, move its contents back to '$repo_root', remove it, and retry."

		for entry in "$repo_root"/* "$repo_root"/.[!.]* "$repo_root"/..?*; do
			[ -e "$entry" ] || [ -L "$entry" ] || continue
			name=$(basename "$entry")
			case "$name" in
			.git | .gitflow-migrate-tmp) continue ;;
			esac
			gitflow_init_preserved_reason "$repo_root" "$name" >/dev/null && continue
			if ! mv "$entry" "$staging/"; then
				if gitflow_init_restore_staging "$repo_root" "$staging"; then
					die "Could not move '$name' out of the repository root. Entries already moved were restored, so the checkout is unchanged. If '$name' is a local build, cache or vendor directory, add it to .gitignore (or .git/info/exclude) and re-run 'git flow init -f --worktree'; otherwise check permissions and close programs (editors, watchers, antivirus) using files inside it."
				fi
				die "Could not move '$name' out of the repository root, and restoring the previously moved entries also failed. Inspect '$staging' and '$repo_root' manually before retrying."
			fi
		done

		mv "$repo_root/.git" "$bare_dir" || die "Could not move '.git' to '.bare'."
		git_do --git-dir="$bare_dir" config core.bare true

		# gitflow.path.hooks may have been stored (moments earlier, in
		# this same init run) as the auto-suggested default inside
		# ".git", which has just become ".bare" -- including its own
		# "hooks/" subdirectory, since the whole directory was moved as
		# one unit. Repoint the stored value in that case; a path the
		# user customized to somewhere unrelated is left untouched.
		if [ "$(git --git-dir="$bare_dir" config --get gitflow.path.hooks 2>/dev/null)" = "$repo_root/.git/hooks" ]; then
			git_do --git-dir="$bare_dir" config gitflow.path.hooks "$bare_dir/hooks"
		fi

		# A plain ".git" pointer file at the hub root lets ordinary git
		# (and git-flow) commands run there find the repository, without
		# making the hub root itself a worktree: core.bare=true means git
		# reports it as bare from that vantage point (no working tree to
		# check out, commit, or require clean), while every linked
		# worktree underneath it still behaves like a normal checkout.
		echo "gitdir: ./.bare" > "$repo_root/.git" || die "Could not create the hub '.git' pointer file."

		if git_do --git-dir="$bare_dir" config --get remote.origin.url >/dev/null 2>&1; then
			git_do --git-dir="$bare_dir" config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
		fi

		git_do --git-dir="$bare_dir" worktree add --no-checkout "$repo_root/$cur_branch" "$cur_branch" || die "Could not register the worktree for '$cur_branch'."

		for entry in "$staging"/* "$staging"/.[!.]* "$staging"/..?*; do
			[ -e "$entry" ] || [ -L "$entry" ] || continue
			mv "$entry" "$repo_root/$cur_branch/" || die "Could not move '$entry' into '$repo_root/$cur_branch'. The repository is already in worktree layout; the remaining staged entries are in '$staging' - move them into place manually."
		done
		rmdir "$staging" 2>/dev/null

		# "--no-checkout" leaves a worktree with an empty index (every
		# tracked file would show as both staged-deleted and untracked).
		# The real files are already on disk with content matching HEAD
		# (the working tree was required to be clean before migrating),
		# so a plain reset re-syncs the index to HEAD without touching
		# any file, correctly leaving only genuinely untracked files as
		# untracked.
		(cd "$repo_root/$cur_branch" && git_do reset -q) || die "Could not resync the index for the '$cur_branch' worktree."

		if [ "$cur_branch" != "$master_branch" ]; then
			git_do --git-dir="$bare_dir" worktree add "$repo_root/$master_branch" "$master_branch" || die "Could not create the worktree for '$master_branch'."
		fi
		if [ "$cur_branch" != "$develop_branch" ]; then
			git_do --git-dir="$bare_dir" worktree add "$repo_root/$develop_branch" "$develop_branch" || die "Could not create the worktree for '$develop_branch'."
		fi
	fi

	# Persistent container directories, one per configured branch-type
	# prefix (trailing slash stripped). A prefix explicitly set to empty
	# ("-") has no sensible container directory and is skipped.
	for prefix in feature bugfix release hotfix support; do
		prefix_dir=$(git --git-dir="$bare_dir" config --get "gitflow.prefix.$prefix")
		prefix_dir=${prefix_dir%/}
		[ -n "$prefix_dir" ] && mkdir -p "$repo_root/$prefix_dir"
	done

	if [ -n "$preserved" ]; then
		printf 'Left untouched in the repository hub (not moved into any worktree):\n%s' "$preserved"
	fi
}

cmd_help() {
	usage
	exit 0
}
